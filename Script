local function scoreCombatName(name)
    local lowered = string.lower(name or "")
    local score = 0
    if string.find(lowered, "slap", 1, true) then score = score + 320 end  
    if string.find(lowered, "glove", 1, true) then score = score + 280 end  
    if string.find(lowered, "hit", 1, true) then score = score + 220 end  
    if string.find(lowered, "kill", 1, true) then score = score + 190 end  
    if string.find(lowered, "fling", 1, true) then score = score + 190 end  
    if lowered == "event" then score = score + 260 end  
    return score
end

local function findGloveRemote(tool)
    if not tool or not tool:IsA("Tool") then return nil, 0 end
    local exactEvent = tool:FindFirstChild("Event", true)  
    if exactEvent and exactEvent:IsA("RemoteEvent") then return exactEvent, 400 end  

    local bestRemote, bestScore = nil, -1  
    for _, descendant in ipairs(tool:GetDescendants()) do  
        if descendant:IsA("RemoteEvent") then  
            local score = 1 + scoreCombatName(descendant.Name)  
            if score > bestScore then bestScore = score; bestRemote = descendant end  
        end  
    end  
    return bestRemote, bestScore
end

local function scanContainer(container, owner, location, recursive, baseScore)
    if not container then return nil, nil, nil, nil, -1 end
    local objects = recursive and container:GetDescendants() or container:GetChildren()  
    local bestTool, bestEvent, bestTotal = nil, nil, -1  

    for _, object in ipairs(objects) do  
        if object:IsA("Tool") then  
            local remote, remoteScore = findGloveRemote(object)  
            if remote then  
                local total = (baseScore or 0) + scoreCombatName(object.Name) + remoteScore  
                if total > bestTotal then bestTool = object; bestEvent = remote; bestTotal = total end  
            end  
        end  
    end  
    return bestTool, bestEvent, owner, location, bestTotal
end

local function getglove(forceRefresh)
    if not forceRefresh and gloveCache.tool and gloveCache.event then
        return gloveCache.tool, gloveCache.event, gloveCache.owner, gloveCache.location
    end
    invalidateGloveCache()  

    local tool, event, owner, location, bestScore = nil, nil, nil, nil, -1  
    local function consider(...)  
        local cTool, cEvent, fOwner, fLoc, score = scanContainer(...)  
        if cEvent and score > bestScore then tool = cTool; event = cEvent; owner = fOwner; location = fLoc; bestScore = score end  
    end  

    consider(localplr.Character, localplr, "Equipada", false, 1200)  
    consider(localplr:FindFirstChild("Backpack"), localplr, "Mochila", false, 1050)  
    for _, player in ipairs(Players:GetPlayers()) do  
        if player ~= localplr then  
            consider(player.Character, player, "Outro jogador equipado", false, 720)  
        end  
    end  

    if event then gloveCache.tool = tool; gloveCache.event = event; gloveCache.owner = owner; gloveCache.location = location end  
    return tool, event, owner, location
end

local STRONG_SLAP_FORCE = 8999999488
local massRetries, massDelay, ignoreSameTeam = 3, 0.05, false
local massActionRunning, massActionToken, massStatus = false, 0, nil

local function setMassStatus(text, color)
    if massStatus and massStatus.Parent then massStatus.Text = text; massStatus.TextColor3 = color or COLORS.muted end
end

local function getMassTargets()
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do  
        local character = player.Character  
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")  
        if player ~= localplr and character and humanoid and humanoid.Health > 0 and character:FindFirstChild("HumanoidRootPart") then  
            if not (ignoreSameTeam and localplr.Team and player.Team == localplr.Team) then table.insert(targets, player) end  
        end  
    end  
    return targets
end

local function runMassAction(actionName, force, color)
    if massActionRunning then return notify("Já existe uma ação em massa rodando", COLORS.yellow) end
    massActionRunning = true; massActionToken = massActionToken + 1; local myToken = massActionToken  

    task.spawn(function()  
        local _, event = getglove(true)  
        if not event then massActionRunning = false; return notify("Nenhuma luva encontrada", COLORS.red) end  

        local targets = getMassTargets()  
        local total, completed = #targets, 0  
        if total == 0 then massActionRunning = false; return notify("Nenhum alvo válido", COLORS.yellow) end  

        setMassStatus(actionName .. ": 0/" .. total, color)  
        for _, player in ipairs(targets) do  
            task.spawn(function()  
                local char = player.Character  
                if char and char:FindFirstChildOfClass("Humanoid") then  
                    pcall(function() event:FireServer("slash", char, Vector3.new(0, force, 0)) end)  
                end  
                completed = completed + 1  
                setMassStatus(actionName .. ": " .. completed .. "/" .. total, color)  
            end)  
        end  

        while completed < total and myToken == massActionToken do task.wait(0.05) end  
        if myToken == massActionToken then massActionRunning = false; notify(actionName .. " concluído", COLORS.green) end  
    end)
end

