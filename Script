    for _, tool in ipairs(backpack:GetChildren()) do if tool:IsA("Tool") and findGloveRemote(tool) then humanoid:EquipTool(tool); invalidateGloveCache(); if not silent then notify("Luva equipada: " .. tool.Name, COLORS.green) end return end end  
end

