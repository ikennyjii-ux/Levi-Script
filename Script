local function isValidTarget(character)
    if not character then return false end
    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if hum and hum.Health > 0 and root then return true, hum, root end
    return false
end

local as = false
local function dobv(v, char)
    if not as then return end
    local undo = false
    if v:IsA("BodyAngularVelocity") then undo = true v:Destroy()  
    elseif v:IsA("BodyGyro") and v.MaxTorque ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.D ~= 500 and v.D ~= 50 and v.P ~= 90000 then undo = true v:Destroy()  
    elseif v:IsA("BodyVelocity") and v.MaxForce ~= Vector3.new(8999999488, 8999999488, 8999999488) and v.Velocity ~= Vector3.new(0, 0, 0) then undo = true v:Destroy()  
    elseif v:IsA("BasePart") then v.ChildAdded:Connect(function(v2) dobv(v2, char) end) end  
    if undo and char and char:FindFirstChild("Humanoid") then char.Humanoid.Sit = false; char.Humanoid.PlatformStand = false end
end
local function dc(character)
    for _, v in pairs(character:GetChildren()) do dobv(v, character); for _, v2 in pairs(v:GetChildren()) do dobv(v2, character) end end
    character.ChildAdded:Connect(function(v) dobv(v, character) end)
end

local gloveCache = { tool = nil, event = nil, owner = nil, location = nil }
local function invalidateGloveCache() gloveCache.tool, gloveCache.event, gloveCache.owner, gloveCache.location = nil, nil, nil, nil end
local function scoreCombatName(n)
    local l, s = string.lower(n or ""), 0
    if string.find(l, "slap", 1, true) then s = s + 320 end  
    if string.find(l, "glove", 1, true) then s = s + 280 end  
    if string.find(l, "hit", 1, true) then s = s + 220 end  
    if string.find(l, "kill", 1, true) then s = s + 190 end  
    if string.find(l, "fling", 1, true) then s = s + 190 end  
    if l == "event" then s = s + 260 end  
    return s
end
local function findGloveRemote(tool)
    if not tool or not tool:IsA("Tool") then return nil, 0 end
    local exactEvent = tool:FindFirstChild("Event", true)  
    if exactEvent and exactEvent:IsA("RemoteEvent") then return exactEvent, 400 end  
    local bestRemote, bestScore = nil, -1  
    for _, descendant in ipairs(tool:GetDescendants()) do if descendant:IsA("RemoteEvent") then local score = 1 + scoreCombatName(descendant.Name) if score > bestScore then bestScore = score; bestRemote = descendant end end end  
    return bestRemote, bestScore
end
local function scanContainer(container, owner, location, recursive, baseScore)
    if not container then return nil, nil, nil, nil, -1 end
    local objects = recursive and container:GetDescendants() or container:GetChildren()  
    local bestTool, bestEvent, bestTotal = nil, nil, -1  
    for _, object in ipairs(objects) do if object:IsA("Tool") then local remote, remoteScore = findGloveRemote(object); if remote then local total = (baseScore or 0) + scoreCombatName(object.Name) + remoteScore; if total > bestTotal then bestTool = object; bestEvent = remote; bestTotal = total end end end end  
    return bestTool, bestEvent, owner, location, bestTotal
end
local function getglove(forceRefresh)
    if not forceRefresh and gloveCache.tool and gloveCache.event then return gloveCache.tool, gloveCache.event, gloveCache.owner, gloveCache.location end
    invalidateGloveCache(); local tool, event, owner, location, bestScore = nil, nil, nil, nil, -1  
    local function consider(...) local cTool, cEvent, fOwner, fLoc, score = scanContainer(...) if cEvent and score > bestScore then tool = cTool; event = cEvent; owner = fOwner; location = fLoc; bestScore = score end end  
    consider(localplr.Character, localplr, "Equipada", false, 1200); consider(localplr:FindFirstChild("Backpack"), localplr, "Mochila", false, 1050)  
    for _, player in ipairs(Players:GetPlayers()) do if player ~= localplr then consider(player.Character, player, "Outro jogador equipado", false, 720) end end  
    consider(workspace, nil, "Workspace", true, 430); consider(ReplicatedStorage, nil, "ReplicatedStorage", true, 350)
    if event then gloveCache.tool = tool; gloveCache.event = event; gloveCache.owner = owner; gloveCache.location = location end  
    return tool, event, owner, location
end

local STRONG_SLAP_FORCE = 8999999488
local massRetries, massDelay, ignoreSameTeam, bypassTeleport = 3, 0.05, false, true
local massActionRunning, massActionToken, massStatus = false, 0, nil
local function setMassStatus(text, color) if massStatus and massStatus.Parent then massStatus.Text = text; massStatus.TextColor3 = color or COLORS.muted end end

local function getMassTargets()
    local targets = {}
    for _, player in ipairs(Players:GetPlayers()) do  
        if player ~= localplr and isValidTarget(player.Character) then  
            if not (ignoreSameTeam and localplr.Team and player.Team == localplr.Team) then table.insert(targets, player) end  
        end  
    end  
    return targets
end

local function cancelMassAction(showNotification) massActionToken = massActionToken + 1; local wasRunning = massActionRunning; massActionRunning = false; setMassStatus("Ação em massa cancelada", COLORS.yellow) if showNotification and wasRunning then notify("Ação em massa cancelada", COLORS.yellow) end end
local function runMassAction(actionName, force, color)
    if massActionRunning then return notify("Já existe uma ação rodando", COLORS.yellow) end
    massActionRunning = true; massActionToken = massActionToken + 1; local myToken = massActionToken  
    task.spawn(function()  
        local _, event = getglove(true)  
        if not event then massActionRunning = false; return notify("Nenhuma luva encontrada", COLORS.red) end  
        local targets = getMassTargets(); local total, completed = #targets, 0  
        if total == 0 then massActionRunning = false; return notify("Nenhum alvo válido", COLORS.yellow) end  
        setMassStatus(actionName .. ": 0/" .. total, color)  
        
        local validMe, _, myRoot = isValidTarget(localplr.Character)
        local originalPos = myRoot and myRoot.CFrame or nil

        for _, player in ipairs(targets) do  
            task.spawn(function()  
                local valid, _, targetRoot = isValidTarget(player.Character)
                if valid then
                    if bypassTeleport and myRoot and targetRoot then
                        -- FIX DE FLING/KILL: Teleporta instantaneamente pro alvo para garantir que o server aceite o golpe
                        myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 2.5)
                        task.wait(0.05) -- Tempo pro ping registrar a posição
                    end
                    pcall(function() event:FireServer("slash", player.Character, Vector3.new(0, force, 0)) end) 
                end  
                completed = completed + 1; setMassStatus(actionName .. ": " .. completed .. "/" .. total, color)  
            end)  
            task.wait(massDelay + (bypassTeleport and 0.05 or 0))
        end  
        
        while completed < total and myToken == massActionToken do task.wait(0.05) end  
        if myToken == massActionToken then 
            massActionRunning = false; notify(actionName .. " concluído", COLORS.green)
            if bypassTeleport and myRoot and originalPos then myRoot.CFrame = originalPos end -- Retorna a posição inicial
        end  
    end)
end

