local globalConnections = {}
local dynamicConnections = {} -- Novo: Gerenciador de conexões dinâmicas otimizadas

local function track(connection)
    table.insert(globalConnections, connection)
    return connection
end

-- Nova função: Liga e desliga loops pesados apenas quando necessário
local function toggleConnection(name, enable, event, callback)
    if enable then
        if not dynamicConnections[name] then
            dynamicConnections[name] = event:Connect(callback)
            track(dynamicConnections[name])
        end
    else
        if dynamicConnections[name] then
            dynamicConnections[name]:Disconnect()
            dynamicConnections[name] = nil
        end
    end
end

