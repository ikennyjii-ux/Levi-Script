local flyBV, flyBG

toggleRow(movePage, "Voo (Fly Mobile Responsivo)", "Calculado a partir do analógico para a câmera.", function(enabled)
    flyEnabled = enabled
    local valid, hum, root = isValidTarget(localplr.Character)
    
    if enabled and valid then
        flyBV = Instance.new("BodyVelocity"); flyBV.MaxForce = Vector3.new(8999999488, 8999999488, 8999999488); flyBV.Velocity = Vector3.zero; flyBV.Parent = root
        flyBG = Instance.new("BodyGyro"); flyBG.MaxTorque = Vector3.new(8999999488, 8999999488, 8999999488); flyBG.P = 9e4; flyBG.Parent = root
        
        -- FIX 3: Desligando as states que causam tremedeira no chão
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        hum:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, false)
        hum:ChangeState(Enum.HumanoidStateType.Physics)
        hum.PlatformStand = true 

        toggleConnection("FlyLoop", true, RunService.RenderStepped, function(deltaTime)
            if hum and root and flyBV and flyBG then
                local cam = workspace.CurrentCamera
                local md = hum.MoveDirection
                
                if md.Magnitude > 0 then
                    local flatCamX = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z); if flatCamX.Magnitude > 0 then flatCamX = flatCamX.Unit end
                    local flatCamZ = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z); if flatCamZ.Magnitude > 0 then flatCamZ = flatCamZ.Unit end
                    local forward = flatCamX:Dot(md); local right = flatCamZ:Dot(md)
                    
                    local targetVel = (cam.CFrame.LookVector * forward + cam.CFrame.RightVector * right) * flySpeed
                    flyBV.Velocity = flyBV.Velocity:Lerp(targetVel, 15 * deltaTime)
                else
                    flyBV.Velocity = flyBV.Velocity:Lerp(Vector3.zero, 15 * deltaTime)
                end
                flyBG.CFrame = flyBG.CFrame:Lerp(cam.CFrame, 20 * deltaTime)
            end
        end)
    else
        if flyBV then flyBV:Destroy() end if flyBG then flyBG:Destroy() end
        toggleConnection("FlyLoop", false)
        if hum then 
            hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.RunningNoPhysics, true)
            hum.PlatformStand = false 
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end)
