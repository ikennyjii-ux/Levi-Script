local toastId = 0
local function notify(text, color)
    toastId = toastId + 1
    local thisId = toastId
    toast.Text = text
    toast.TextColor3 = color or COLORS.white
    toast.Visible = true
    tween(toast, 0.18, {BackgroundTransparency = 0.05, TextTransparency = 0})

    task.delay(2, function()  
        if toast.Parent and thisId == toastId then  
            tween(toast, 0.18, {BackgroundTransparency = 1, TextTransparency = 1})  
            task.wait(0.2)  
            if thisId == toastId then  
                toast.Visible = false  
            end  
        end  
    end)
end

